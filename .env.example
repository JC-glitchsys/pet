# ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token (REQUIRED for real data)
# Create one at https://github.com/settings/tokens
#   • Classic token: tick NO scopes (public data only), or "read:user"
#     if you want private contributions counted.
#   • Fine-grained token: "Public repositories (read-only)" is enough.
# Without a token the app falls back to demo data so you can still
# develop the UI locally.
# ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of your deployment (OG tags + README snippets).
NEXT_PUBLIC_SITE_URL=https://my-pet.vercel.app
